{
  /*
  "Logging": {
    "IncludeScopes": false,
    "LogLevel": {
      "Default": "Warning"
    }
  },
  */
  "ConnectionStrings": {
    /*"WorkoutTrackerDatabase": "Server=.;Database=WorkoutTrackerDev;Trusted_Connection=True;TrustServerCertificate=true"*/
	  "WorkoutTrackerDatabase": "Server=AHUMMEL\\SQLEXPRESS;Database=WorkoutTracker;Trusted_Connection=True;TrustServerCertificate=true"
  },
  "Jwt": {
    /* REQUIRED: set Jwt:Key before running. Do NOT put a real key in this file.
     Generate a random 64-byte key and store it with user-secrets or an environment variable.
     See "Configuring the JWT signing key" in the README. */
    "Key": "",
    "Issuer": "www.workouttracker.net",
    "AccessTokenLifetimeMinutes": 120,
    "RefreshTokenLifetimeDays": 7
  },
  "Cors": {
    /* Origins (scheme://host[:port], no trailing slash) allowed to call the API from a browser.
       Leave empty when the SPA reaches the API through a same-origin proxy (dev server, Aspire, nginx).
       Different ports are different origins. See "CORS" in the README. */
    "AllowedOrigins": []
  },
  "Setup": {
    /* Optional. Leave blank and the API prints a generated one-time setup code to its console while no user exists.
       Hosts that don't show the console (IIS) can set a code here instead: a random value of at least 16 characters.
       Never commit a real one (use appsettings.Production.json or an environment variable) and remove it once the
       first administrator exists. See "First-run setup" in the README. */
    "Code": ""
  },
  "SimpleLogin": true, /* Set this to true when the front end uses loginWithUserSelect=true */
  "SMTP": {
    "Enabled": false,
    "Host": "smtp.someemail.com",
    "Port": 587,
    "Username": "email",
    "Password": "password"
  },
  /* The full address of the password reset page (no token, no trailing slash), used for the link in reset emails,
     e.g. "https://app.example.com/user/reset-password". The API refuses to start if this is not an absolute http(s) URL. */
  "FrontEndResetPasswordURL": "http://localhost:4200/user/reset-password",
  "PasswordReset": {
    "TokenLifetimeMinutes": 60,
    /* Per client IP, for the three anonymous reset endpoints (request, validate, reset). */
    "RateLimit": { "PermitLimit": 10, "WindowMinutes": 15 }
  },
  "AllowedHosts": "*",
  "Serilog": {
    /* Great information found here: https://jkdev.me/asp-net-core-serilog/ */
    /* And here: https://github.com/serilog/serilog/wiki/Configuration-Basics */
    "Using": [ "Serilog.Exceptions", "Serilog", "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        /* Lets the one "Setup:Code is still configured" warning through despite the Error default. */
        "WorkoutTracker.Setup": "Information",
        /* Lets the audit line for an administrator creating a password reset through despite the Error default. */
        "WorkoutTracker.Application.Users.Services.PasswordResetService": "Information"
      }
      /* More examples:
      "Override": {
        "System": "Information",
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Information"
      }
      */
  },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "restrictedToMinimumLevel": "Information"
              }
            }
          ]
        }
      },
      {
        "Name": "File",
        "Args": { "path": "log.txt" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithExceptionDetails" ],
    "Properties": {
      "Environment": "Production"
    }
  }
}
